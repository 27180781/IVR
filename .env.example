# ---- ARI (Asterisk REST Interface) ----
# The app runs ON the Asterisk server, so this stays on loopback.
# Never expose 8088 to the internet.
ARI_URL=http://127.0.0.1:8088
ARI_USERNAME=ivr
ARI_PASSWORD=change-me-to-a-long-random-string
ARI_APP=ivr-app

# ---- IVR ----
# Asterisk language directory used to resolve sound files:
# playing "ivr/welcome" resolves to /usr/share/asterisk/sounds/he/ivr/welcome.<ext>
IVR_LANGUAGE=he

# ---- Data source (the "system" the IVR reads from) ----
# mock = built-in fixtures, good for development
# http = call an external HTTP API
DATA_SOURCE=mock
DATA_HTTP_URL=
DATA_HTTP_TOKEN=
DATA_HTTP_TIMEOUT_MS=3000

# ---- Ops ----
LOG_LEVEL=info
CALL_LOG_PATH=./data/calls.jsonl

# How long to let calls in progress finish before exiting on SIGTERM.
# Deploys restart the service, so this is what keeps a deploy from cutting
# callers off mid-sentence. systemd's TimeoutStopSec must exceed it.
SHUTDOWN_DRAIN_TIMEOUT_MS=120000

# ---- Dashboard ----
# Served on loopback only; put a reverse proxy in front of it for TLS.
# Without WEB_PASSWORD the dashboard refuses to start - call records contain
# callers' phone numbers and must not be served unauthenticated.
WEB_ENABLED=true
WEB_PORT=3000
WEB_BIND=127.0.0.1
WEB_USER=admin
WEB_PASSWORD=
WEB_LOG_BUFFER=500

# ---- Outbound dialling (DISA) ----
# Lets a caller who reaches the menu dial another number, billed to your
# account. This is the most exploited feature in telephony, so it is off by
# default and refuses to start without a PIN.
OUTBOUND_ENABLED=false
OUTBOUND_PIN=
OUTBOUND_TRUNK_ENDPOINT=twilio

# Whose number the destination sees:
#   trunk    - your Twilio number. Always works.
#   original - the inbound caller's own number. Carriers restrict this: Twilio
#              accepts a From only if the number is owned by your account or
#              listed under Verified Caller IDs. Falls back to the number below.
#   fixed    - always OUTBOUND_CALLERID_NUMBER.
OUTBOUND_CALLERID_MODE=trunk
OUTBOUND_CALLERID_NUMBER=

# Comma-separated E.164 prefixes callers may dial, e.g. +972,+1
# Empty means anywhere - which is what fraud costs are made of.
OUTBOUND_ALLOWED_PREFIXES=

OUTBOUND_TIMEOUT_SEC=45
OUTBOUND_MAX_DURATION_SEC=600
